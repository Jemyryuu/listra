{
  "name": "listra",
  "version": "1.0.0",
  "description": "Real-time Spotify playback sync over WebRTC with Discord Rich Presence",
  "scripts": {
    "build:extension": "npm --prefix extension run build",
    "apply:extension": "npm --prefix extension run apply",
    "start:daemon": "npm --prefix daemon start",
    "register:protocol": "npm --prefix daemon run register-protocol",
    "deploy:web": "wrangler pages deploy web --project-name=listra",
    "deploy:signaling": "npm --prefix signaling run deploy"
  }
}
